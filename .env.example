# Copie este arquivo para .env.local e preencha.

# Endereço do Diagnóstico da Escala IMOB. Vazio = endereço oficial padrão (https://escalaimob.com.br).
# Preencha só para trocar o endereço. Um valor inválido desabilita o botão, com aviso.
NEXT_PUBLIC_DIAGNOSTICO_URL=

# ── Captura de leads ao exportar (Google Sheets via Apps Script) ──────────────────────────────
# Passo a passo: integracoes/google-sheets/LEIA-ME.md
# Enquanto QUALQUER uma das 3 variáveis abaixo estiver vazia, a captura fica DESLIGADA:
# não há etapa de cadastro e "Baixar PDF"/"Copiar link" funcionam direto.
# Nunca use prefixo NEXT_PUBLIC_ nos segredos. Não compartilhe estes valores por chat ou e-mail.

# URL do App da Web do Apps Script (termina em /exec)
LEADS_SHEETS_WEBHOOK_URL=
# Mesmo valor da propriedade LEADS_TOKEN do script (24+ caracteres)
LEADS_SHEETS_TOKEN=
# Segredo aleatório (16+ caracteres) usado para o hash do IP no limite de envios
LEADS_IP_SALT=

# Opcionais
# Outros domínios que podem enviar leads (separados por vírgula). Padrão: o próprio domínio do site.
LEADS_ALLOWED_ORIGINS=
# Envios por IP a cada 10 minutos. Padrão: 5.
LEADS_RATE_LIMIT=
